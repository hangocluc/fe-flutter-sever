PORT=3001
HOST=0.0.0.0

# Gmail SMTP (admin reply email) — MUST use App Password, not normal Gmail password
# https://myaccount.google.com/apppasswords (requires 2-Step Verification)
SMTP_USER=your.email@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# Firebase Admin SDK (FCM) — cùng project app Flutter: applea-e4729
FIREBASE_PROJECT_ID=applea-e4729
# Cách 1: tải Service Account JSON → đặt ở thư mục gốc (tên *-firebase-adminsdk-*.json, đã gitignore)
# FIREBASE_SERVICE_ACCOUNT_PATH=./applea-e4729-firebase-adminsdk-xxxxx.json
# Cách 2 (deploy): paste JSON một dòng
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# Local MongoDB (recommended for dev)
MONGODB_URI=mongodb://127.0.0.1:27017/flutter_server?directConnection=true

# If you use Mongo Atlas instead, set it like:
# MONGODB_URI=mongodb+srv://<user>:<pass>@<cluster-host>/<db>?retryWrites=true&w=majority

# Nhắc học tự động — gửi tới mọi tokenDevice trong MongoDB (không cần subscribe topic)
STUDY_REMINDER_ENABLED=true
STUDY_REMINDER_TIMEZONE=Asia/Ho_Chi_Minh
STUDY_REMINDER_TIMES=08:00,20:25
STUDY_REMINDER_TITLE=Nhắc học Flutter
STUDY_REMINDER_BODY=Mở app học bài hôm nay nhé!
# STUDY_REMINDER_USE_TOPIC=true  # bật nếu app đã subscribeToTopic('all')

# --- Render / production (set in Dashboard → Environment, not .env file) ---
# MONGODB_URI=mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/flutter_server?retryWrites=true&w=majority
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}   # one-line JSON from Firebase Console
# FIREBASE_PROJECT_ID=applea-e4729
# PORT is set automatically by Render; do not hardcode 3001 there
