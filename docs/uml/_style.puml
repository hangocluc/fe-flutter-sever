' ============================================================
' Style đơn giản đen trắng — luận văn UML
' Cỡ chữ đồng bộ: sửa một chỗ FONT_SIZE bên dưới
' Include: !include ../_style.puml
' ============================================================

' --- Cỡ chữ: nội dung 14, title 18 (đổi TITLE_SIZE / FONT_SIZE tại đây) ---
' FONT_SIZE = 14, TITLE_SIZE = 18

skinparam style strictuml
skinparam monochrome true
skinparam shadowing false
skinparam roundcorner 0
skinparam handwritten false

skinparam backgroundColor white
skinparam defaultFontName Arial
skinparam defaultFontSize 14
skinparam defaultFontStyle bold

skinparam actorFontSize 14
skinparam boundaryFontSize 14
skinparam controlFontSize 14
skinparam participantFontSize 14
skinparam databaseFontSize 14
skinparam entityFontSize 14

skinparam ParticipantPadding 40
skinparam BoxPadding 10
skinparam MinClassWidth 125
skinparam MaxClassWidth 125

skinparam sequence {
  LifeLineBorderColor black
  LifeLineBackgroundColor white
  ArrowColor black
  ArrowFontColor black
  ArrowFontSize 14
  ArrowFontStyle bold
  ArrowThickness 2
  BorderColor black
  TitleFontSize 18
  TitleFontStyle bold
  DelayFontSize 14
  DelayFontStyle bold
  DividerFontSize 14
  DividerFontStyle bold
  GroupFontColor black
  GroupFontSize 14
  GroupFontStyle bold
  GroupHeaderFontColor black
  GroupHeaderFontSize 14
  GroupHeaderFontStyle bold
  GroupBorderColor black
  GroupHeaderBackgroundColor white
  DividerBackgroundColor white
  DividerBorderColor black
  BoxBackgroundColor white
  BoxBorderColor black
  ParticipantBorderColor black
  ParticipantBackgroundColor white
  ActorBorderColor black
  ActorBackgroundColor white
  ActorFontColor black
  ActorBorderThickness 2
  ParticipantBorderThickness 2
  LifeLineBorderThickness 1
}

skinparam participant {
  BackgroundColor white
  BorderColor black
  FontColor black
  FontSize 14
  FontStyle bold
}

skinparam actor {
  BackgroundColor white
  BorderColor black
  FontColor black
  FontSize 14
  FontStyle bold
}

skinparam boundary {
  BackgroundColor white
  BorderColor black
  FontColor black
  FontSize 14
  FontStyle bold
}

skinparam control {
  BackgroundColor white
  BorderColor black
  FontColor black
  FontSize 14
  FontStyle bold
}

skinparam entity {
  BackgroundColor white
  BorderColor black
  FontColor black
  FontSize 14
  FontStyle bold
}

skinparam database {
  BackgroundColor white
  BorderColor black
  FontColor black
  FontSize 14
  FontStyle bold
}

skinparam note {
  BackgroundColor white
  BorderColor black
  FontColor black
  FontSize 14
  FontStyle bold
}

skinparam title {
  FontColor black
  FontSize 18
  FontStyle bold
  BorderColor white
  BackgroundColor white
}

skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true

hide footbox
