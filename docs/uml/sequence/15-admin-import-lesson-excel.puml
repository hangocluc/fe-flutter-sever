@startuml 15-admin-import-lesson-excel
!include ../_style.puml

title Import bài học từ file Excel (Admin)

actor "Quản trị viên" as Admin
boundary "Giao diện hệ thống" as UI
control "Hệ thống xử lý" as SYS
participant "Bộ nhớ file" as FS
database "CSDL" as DB

autonumber

Admin -> UI: Chọn file Excel, submit
UI -> SYS: Chuyển yêu cầu
UI -> SYS: upload.single('file_excel')
SYS -> FS: lưu file (timestamp-random-name)
FS --> SYS: file path
SYS -> SYS: importLessonFromExcelFile(req, res)
activate SYS

SYS -> SYS: readFile(path)
SYS --> SYS: workbook (sheets: Lesson, Topics, Questions...)

loop Mỗi dòng Lesson
  SYS -> DB: Lesson.save() / update
end

loop Mỗi Topic thuộc lesson_id
  SYS -> SYS: _rowBelongsToLesson()
  SYS -> DB: Topic.save()
end

loop Mỗi Question / Quiz
  SYS -> DB: Quiz.findOne / Question.save()
end

alt Import thành công
  SYS --> UI: redirect hoặc render lesson\n(danh sách đã cập nhật)
else Lỗi định dạng / DB
  SYS --> UI: thông báo lỗi
end

deactivate SYS

note over SYS, DB
  Khóa lesson: cột id sheet Lesson
  Topic/Question tham chiếu lesson_id
end note

@enduml
