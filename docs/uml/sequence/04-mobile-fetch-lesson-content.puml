@startuml 04-mobile-fetch-lesson-content
!include ../_style.puml

title Lấy nội dung bài học — Lesson, Topic, Quiz (Mobile)

actor "Người dùng" as User
boundary "Giao diện hệ thống" as UI
control "Hệ thống xử lý" as SYS
database "CSDL" as DB

autonumber

User -> UI: Chọn bài học
UI -> SYS: Chuyển yêu cầu
UI -> SYS: getAllLesson()
SYS -> DB: Lesson.find({})
DB --> SYS: danh sách Lesson
SYS --> UI: Trả kết quả

UI -> SYS: Chuyển yêu cầu
UI -> SYS: getTopicByLessonId()
alt Thiếu lessonId
  SYS --> UI: Trả kết quả
else Có lessonId
  SYS -> DB: Topic.find({lessonId})
  DB --> SYS: topics[]
  SYS --> UI: Trả kết quả
end

UI -> SYS: Chuyển yêu cầu
UI -> SYS: getQuestionByLessonId()
alt Thiếu lessonId
  SYS --> UI: Trả kết quả
else Có lessonId
  SYS -> DB: Quiz.findOne({lessonId})
  DB --> SYS: quiz | null
  alt quiz == null
    SYS --> UI: Trả kết quả
  else Có quiz
    SYS -> DB: Question.find({quizId: quiz._id})
    DB --> SYS: questions[]
    SYS --> UI: Trả kết quả
  end
end

opt Tải gộp một lần
UI -> SYS: Chuyển yêu cầu
  UI -> SYS: getAllByLesson()
  note right of SYS: Gộp topic + quiz + question\n(theo implementation ApiController)
end

@enduml
