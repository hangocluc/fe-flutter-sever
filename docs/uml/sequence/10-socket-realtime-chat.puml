@startuml 10-socket-realtime-chat
!include ../_style.puml

title Chat thời gian thực — Socket.io JoinRoomChat

actor "Người dùng" as User
boundary "Giao diện hệ thống" as UI
control "Hệ thống xử lý" as SYS
database "CSDL" as DB
participant "Client khác trong phòng" as Others

autonumber

User -> UI: Mở màn hình thảo luận quiz
UI -> SYS: connect(WebSocket)
SYS --> UI: connection established

UI -> SYS: emit("JoinRoomChat", JSON string)\n{questionId, userId, username, message, vote, imageUrl, ...}
activate SYS

SYS -> SYS: JSON.parse(chat)
SYS -> SYS: validate message

alt message hợp lệ (không rỗng)
  SYS -> DB: new Chat({questionId, userId, username, quizId, vote, imageUrl, message, date}).save()
  activate DB
  DB --> SYS: chat document
  deactivate DB
  SYS -> SYS: socket.join(questionId)
  SYS -> UI: io.in(questionId).emit("ChatAtRoom", {data: chat})
else message rỗng (chỉ vào phòng)
  SYS -> SYS: socket.join(questionId)
  SYS -> UI: emit("ChatAtRoom", {data: ''})
end

deactivate SYS
UI --> UI: nhận tin mới realtime

@enduml
