@startuml 16-admin-import-program
!include ../_style.puml

title Import chương trình học từ Excel (Admin)

actor "Quản trị viên" as Admin
boundary "Giao diện hệ thống" as UI
control "Hệ thống xử lý" as SYS
participant "Bộ nhớ file" as FS
database "CSDL" as DB

autonumber

Admin -> UI: Upload programs.xlsx
UI -> SYS: Chuyển yêu cầu
UI -> SYS: diskStorage → public/uploads
SYS -> FS: ghi file
SYS -> SYS: importProgram(req, res)
activate SYS

SYS -> SYS: đọc Excel, parse rows
loop Mỗi Program
  SYS -> DB: Program.save()
end
loop Mỗi ProgramDetail
  SYS -> DB: ProgramDetail.save({programId, ...})
end

SYS --> UI: phản hồi (render / redirect programs)
deactivate SYS

@enduml
