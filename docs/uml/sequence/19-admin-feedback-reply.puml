@startuml 19-admin-feedback-reply
!include ../_style.puml

title Admin phản hồi feedback (Email + FCM)

actor "Quản trị viên" as Admin
boundary "Giao diện hệ thống" as UI
control "Hệ thống xử lý" as SYS
database "CSDL" as DB
participant "Firebase FCM" as FCM
participant "Máy chủ email" as SMTP

autonumber

Admin -> UI: Nhập nội dung phản hồi và gửi
UI -> SYS: Chuyển yêu cầu
activate SYS

opt [Có tokenDevice]
  SYS -> FCM: Gửi push thông báo (admin_reply)
  FCM --> SYS: Trả về kết quả
end

alt [SMTP tắt (mail.enabled = false)]
  SYS -> DB: Cập nhật QA status = true
  DB --> SYS: Trả về kết quả
  SYS --> UI: Chuyển hướng detail_pending
  UI --> Admin: Hiển thị đã xử lý (không gửi email)
else [SMTP bật]
  SYS -> SMTP: sendMail(to, subject, html)
  alt [Gửi email thất bại]
    SMTP --> SYS: Lỗi
    SYS --> UI: HTTP 500 + thông báo lỗi
    UI --> Admin: Hiển thị lỗi cấu hình SMTP
  else [Gửi email thành công]
    SMTP --> SYS: OK
    SYS -> DB: Cập nhật QA status = true
    DB --> SYS: Trả về kết quả
    SYS --> UI: Chuyển hướng detail_pending
    UI --> Admin: Hiển thị đã phản hồi
  end
end

deactivate SYS

@enduml
