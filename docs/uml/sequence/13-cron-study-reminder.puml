@startuml 13-cron-study-reminder
!include ../_style.puml

title Nhắc học định kỳ — SYS Job + FCM multicast

control "Hệ thống xử lý" as SYS
database "CSDL" as DB
participant "Firebase FCM" as FCM

autonumber

SYS -> SYS: cron.schedule(expression)\n(theo STUDY_REMINDER_TIMES)
note right of SYS
  Timezone: STUDY_REMINDER_TIMEZONE
  Ví dụ: 08:00, 20:00
end note

SYS -> SYS: sendStudyReminder(overrides?)
activate SYS

SYS -> SYS: đọc title, body từ env\nSTUDY_REMINDER_TITLE, STUDY_REMINDER_BODY
SYS -> SYS: payload.data.type = "study_reminder"

SYS -> DB: User.find({ tokenDevice: {$exists: true, $nin: ['', null]} })\n.select('tokenDevice gmail')
DB --> SYS: users[]

SYS -> SYS: lọc token hợp lệ\n(loại bỏ placeholder flutter_device_token)

alt tokens.length > 0
  SYS -> SYS: sendToDevices(tokens, payload)
  activate SYS
  SYS -> FCM: sendEachForMulticast({tokens, notification, data})
  FCM --> SYS: {successCount, failureCount}
  SYS --> SYS: result
  SYS -> SYS: console.log(successCount/total)
  deactivate SYS
else Không có token
  SYS -> SYS: log "cần POST /api/insert-user từ app"
end

opt STUDY_REMINDER_USE_TOPIC == "true"
  SYS -> SYS: sendToTopic("all", payload)
  SYS -> FCM: messaging.send({topic})
  FCM --> SYS: OK
end

deactivate SYS

@enduml
