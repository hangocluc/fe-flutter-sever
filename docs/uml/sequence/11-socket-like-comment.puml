@startuml 11-socket-like-comment
!include ../_style.puml

title Like bình luận realtime — Socket.io ClickLike

actor "Người dùng" as User
boundary "Giao diện hệ thống" as UI
control "Hệ thống xử lý" as SYS
database "CSDL" as DB

autonumber

User -> UI: Nhấn like bình luận
UI -> SYS: emit("ClickLike", data JSON, userId)
activate SYS

SYS -> SYS: JSON.parse(data)
SYS -> DB: Chat.findOne({_id: Data._id})
DB --> SYS: chat | null

alt chat == null
  SYS --> UI: (không phản hồi)
else chat tồn tại
  alt userId đã trong userLiked[]
    SYS -> SYS: vote = vote - 1\nxóa userId khỏi userLiked
  else Chưa like
    SYS -> SYS: vote = vote + 1\npush userId vào userLiked
  end
  SYS -> DB: chat.save()
  DB --> SYS: c (đã lưu)
  SYS -> DB: Chat.find({questionId: c.questionId})
  DB --> SYS: chats[] (toàn bộ phòng)
  SYS -> SYS: socket.join(questionId)
  SYS -> UI: io.in(questionId).emit("Refresh", {data: chats})
  UI --> UI: cập nhật UI danh sách chat
end

deactivate SYS

@enduml
