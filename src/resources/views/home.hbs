                <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.3/dist/chart.umd.min.js"></script>
                <script type="text/javascript" src="https://cdn.jsdelivr.net/jquery/latest/jquery.min.js"></script>
                <script type="text/javascript" src="https://cdn.jsdelivr.net/momentjs/latest/moment.min.js"></script>
                <script type="text/javascript"
                    src="https://cdn.jsdelivr.net/npm/daterangepicker/daterangepicker.min.js"></script>
                <link rel="stylesheet" type="text/css"
                    href="https://cdn.jsdelivr.net/npm/daterangepicker/daterangepicker.css" />
                <input id="list-lesson" style="display: none;" value="{{this.listLesson}}"></input>
                <input id="list-Count" style="display: none;" value="{{this.listCount}}"></input>
                <input id="list-lesson2" style="display: none;" value="{{this.listLesson2}}"></input>
                <input id="list-Count2" style="display: none;" value="{{this.listCount2}}"></input>

                <style>
                    .fl-chart-card {
                        background: #fff;
                        border: 1px solid #e3e6f0;
                        border-radius: 12px;
                        box-shadow: 0 2px 12px rgba(58, 59, 69, 0.08);
                        padding: 20px 24px 24px;
                        margin: 24px 0;
                    }
                    .fl-chart-card__title {
                        font-size: 1rem;
                        font-weight: 700;
                        color: #5a5c69;
                        text-transform: uppercase;
                        letter-spacing: .04em;
                        margin: 0 0 4px;
                    }
                    .fl-chart-card__subtitle {
                        font-size: .8rem;
                        color: #858796;
                        margin: 0 0 16px;
                    }
                    .fl-chart-card__canvas {
                        position: relative;
                        width: 100%;
                    }
                </style>

                <div class="container-fluid">
                    {{!-- Thống kê tất cả bài học --}}
                    <div class="fl-chart-card">
                        <h4 class="fl-chart-card__title">Statistics of the number of learners per lesson</h4>
                        <p class="fl-chart-card__subtitle">All lessons, ordered as listed</p>
                        <div class="fl-chart-card__canvas" id="wrap-myChartAll">
                            <canvas id="myChartAll"></canvas>
                        </div>
                    </div>

                    {{!-- Top học nhiều nhất --}}
                    <div class="fl-chart-card">
                        <h4 class="fl-chart-card__title">Top 10 most learned lessons</h4>
                        <p class="fl-chart-card__subtitle">Lessons with the highest number of learners</p>
                        <div class="fl-chart-card__canvas" id="wrap-myChart">
                            <canvas id="myChart"></canvas>
                        </div>
                    </div>

                    {{!-- Top học ít nhất --}}
                    <div class="fl-chart-card">
                        <h4 class="fl-chart-card__title">Top 10 least learned lessons</h4>
                        <p class="fl-chart-card__subtitle">Lessons with the lowest number of learners</p>
                        <div class="fl-chart-card__canvas" id="wrap-myChart2">
                            <canvas id="myChart2"></canvas>
                        </div>
                    </div>
                </div>

                <script>
                    (function () {
                        // ----- Palette nhất quán (theo tông màu của template SB Admin 2) -----
                        var PALETTE = [
                            '#4e73df', '#1cc88a', '#36b9cc', '#f6c23e', '#e74a3b',
                            '#6f42c1', '#fd7e14', '#20c9a6', '#5a5c69', '#e83e8c'
                        ];
                        var colorsFor = function (n) {
                            var out = [];
                            for (var i = 0; i < n; i++) out.push(PALETTE[i % PALETTE.length]);
                            return out;
                        };

                        // ----- Đọc & làm sạch dữ liệu -----
                        var parseList = function (id) {
                            var raw = document.getElementById(id).getAttribute('value') || '';
                            return raw.split('/').filter(function (v) { return v !== ''; });
                        };
                        var toNumbers = function (arr) {
                            return arr.map(function (v) { return Number(v) || 0; });
                        };

                        var arrLesson = parseList('list-lesson');
                        var arrCount = toNumbers(parseList('list-Count'));

                        var arrLesson2 = parseList('list-lesson2');
                        var arrCount2 = toNumbers(parseList('list-Count2'));

                        // Top 10 nhiều nhất / ít nhất (dùng slice nên không phá mảng gốc)
                        var topLessons = arrLesson2.slice(0, 10);
                        var topCounts = arrCount2.slice(0, 10);
                        var bottomLessons = arrLesson2.slice(-10);
                        var bottomCounts = arrCount2.slice(-10);

                        // ----- Cấu hình chung -----
                        Chart.defaults.font.family =
                            "-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif";
                        Chart.defaults.color = '#5a5c69';

                        var horizontalBarOptions = function () {
                            return {
                                indexAxis: 'y',
                                responsive: true,
                                maintainAspectRatio: false,
                                layout: { padding: { right: 12 } },
                                plugins: {
                                    legend: { display: false },
                                    tooltip: {
                                        backgroundColor: '#3a3b45',
                                        padding: 10,
                                        cornerRadius: 6,
                                        callbacks: {
                                            label: function (ctx) {
                                                return ' ' + ctx.parsed.x + ' learner(s)';
                                            }
                                        }
                                    }
                                },
                                scales: {
                                    x: {
                                        beginAtZero: true,
                                        ticks: { precision: 0 },
                                        grid: { color: '#eaecf4' }
                                    },
                                    y: {
                                        grid: { display: false },
                                        afterFit: function (scale) { scale.width = 320; },
                                        ticks: {
                                            autoSkip: false,
                                            crossAlign: 'far',
                                            callback: function (value) {
                                                var label = this.getLabelForValue(value);
                                                return label.length > 44 ? label.slice(0, 43) + '…' : label;
                                            }
                                        }
                                    }
                                }
                            };
                        };

                        var datasetFor = function (data) {
                            return [{
                                data: data,
                                backgroundColor: colorsFor(data.length),
                                borderRadius: 6,
                                borderSkipped: false,
                                maxBarThickness: 26
                            }];
                        };

                        // Chiều cao co giãn theo số bản ghi để các thanh không bị bóp méo
                        var setHeight = function (wrapId, count) {
                            var h = Math.max(220, count * 34 + 60);
                            document.getElementById(wrapId).style.height = h + 'px';
                        };

                        setHeight('wrap-myChartAll', arrLesson.length);
                        setHeight('wrap-myChart', topLessons.length);
                        setHeight('wrap-myChart2', bottomLessons.length);

                        new Chart('myChartAll', {
                            type: 'bar',
                            data: { labels: arrLesson, datasets: datasetFor(arrCount) },
                            options: horizontalBarOptions()
                        });

                        new Chart('myChart', {
                            type: 'bar',
                            data: { labels: topLessons, datasets: datasetFor(topCounts) },
                            options: horizontalBarOptions()
                        });

                        new Chart('myChart2', {
                            type: 'bar',
                            data: { labels: bottomLessons, datasets: datasetFor(bottomCounts) },
                            options: horizontalBarOptions()
                        });
                    })();
                </script>



            </div>
            <footer class="bg-white sticky-footer">
